# ============================================================================
# 環境變數範本
# ----------------------------------------------------------------------------
# 唔設任何變數 → 完全等同現有 Jacob 部署。
# 要為「另一個 BB」開新部署時，喺 Vercel 專案逐個設定以下變數即可，
# 唔使改任何程式碼。每個 BB 必須用「新 Firebase 專案 + 新 DATA_PREFIX」隔離資料。
# ============================================================================

# ── AI 週報（Google Gemini） ────────────────────────────────────────────────
GEMINI_API_KEY=
VITE_GEMINI_API_KEY=

# ── BB 身份 ─────────────────────────────────────────────────────────────────
# VITE_BABY_NAME=BB英文名
# VITE_BIRTH_DATE=2026-01-01            # YYYY-MM-DD
# VITE_BABY_GENDER=female               # male | female（影響成長曲線基準同週報用字）
# VITE_BABY_NATIONALITY=中國籍

# ── 品牌（標題 / PWA / 封面相） ──────────────────────────────────────────────
# VITE_APP_TITLE=Emma 成長日記
# VITE_APP_SHORT_NAME=Emma日記
# VITE_PROFILE_IMAGE=/emma.jpg          # 相片放喺 public/ 並 commit 入 repo

# ── 資料隔離前綴（Firestore collection 會變 <prefix>_logs 等） ───────────────
# VITE_DATA_PREFIX=emma

# ── 新 Firebase 專案設定（喺 Firebase Console > 專案設定 > 你的應用程式 取得） ──
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your-project
# VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MEASUREMENT_ID=
